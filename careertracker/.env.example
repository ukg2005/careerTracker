# Copy this to .env and fill in values for local dev.
# On Render, set these as environment variables in the dashboard.

SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-render-service.onrender.com

# Render PostgreSQL — Render injects DATABASE_URL automatically when attached
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Your deployed Vercel frontend URL (no trailing slash)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Resend (recommended for production)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@yourdomain.com

# Optional SMTP fallback (typically local dev only)
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
